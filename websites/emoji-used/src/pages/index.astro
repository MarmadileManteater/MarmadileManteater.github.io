---
import MasterTemplate from '../../../personal-site/src/layouts/master.astro'
import { readdir } from 'fs/promises'
import { Foreach } from '@marmadilemanteater/astro-logic-components'
import emojiMap from '../../../../packages/emoji-to-othermoji/unicode-emoji-map.json'

const unicodeMap = {}
for (const emoji in emojiMap) {
  // @ts-ignore
  const { name, unicode } = emojiMap[emoji]
  // @ts-ignore
  unicodeMap[unicode] = {
    name,
    emoji
  }
}
// @ts-ignore
unicodeMap['2663-fe0f'] = {
  name: emojiMap['❤'].name,
  emoji: '❤'
}

const unicodeKeys = Object.keys(unicodeMap).sort((a, b) => b.length - a.length)

const twemoji = await readdir('../personal-site/dist/images/emoji/twemoji')
const mutantstd = await readdir('../personal-site/dist/images/emoji/mutantstd')
---

<MasterTemplate title="Emoji Used" showEmojiLink={false}>
  <div class="card-top card border-when-light tnb-on-tablet">
      <h1 class="mt-0">Emoji used on this site</h1>
      <h4 class="mt-0">Twemoji</h4>
      <div class="emoji">
        <Foreach list={twemoji}>
          {(emoji: string) => {
            let rawUnicode = emoji.split('.')[0]
            if (unicodeKeys.indexOf(rawUnicode) === -1) {
              const similarKeys = unicodeKeys.filter(key => key.startsWith(rawUnicode))
              rawUnicode = similarKeys[0]
            }
            // @ts-ignore
            const emojiObject  = unicodeMap[rawUnicode]
            return <img src={`/images/emoji/twemoji/${emoji}`} title={emojiObject.name} alt={emojiObject.emoji} style="width: 1.5em; height: 1.5em; vertical-align: top; margin-right: 0.15em;" class="emoji">
          }}
        </Foreach>
      </div>
      <h4>Mutant Standard</h4>
      <div class="emoji">
        <Foreach list={mutantstd}>
          {(emoji: string) => {
            let rawUnicode = emoji.split('.')[0]
            if (unicodeKeys.indexOf(rawUnicode) === -1) {
              const similarKeys = unicodeKeys.filter(key => rawUnicode.startsWith(key))
              rawUnicode = similarKeys[0]
            }
            // @ts-ignore
            const emojiObject  = unicodeMap[rawUnicode]
            return <img src={`/images/emoji/mutantstd/${emoji}`} title={emojiObject.name} alt={emojiObject.emoji} style="width: 1.5em; height: 1.5em; vertical-align: top; margin-right: 0.15em;" class="emoji">
          }}
        </Foreach>
      </div>
  </div>
</MasterTemplate>

<style scoped>
  .emoji {
    font-size: 1.3em;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75em;
  }
</style>

