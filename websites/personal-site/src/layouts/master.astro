---
import './master.less'
import { If } from '@marmadilemanteater/astro-logic-components'
import SiteFooter from '../components/site-footer/site-footer.astro'
import { sourceUrlBase } from '../constants'

interface Props {
  title?: string
  pathname?: string
  showEmojiLink?: boolean
}
const { title, pathname, showEmojiLink = true } = Astro.props

let path = pathname || Astro.url.pathname
if (!path.endsWith('/')) {
  path += '/'
}
---
<!DOCTYPE HTML>
<html>
  <Fragment set:html={`<!-- page source: ${new URL(`./src/pages${path}index.astro`, sourceUrlBase)} -->`} />
  <head>
    <meta charset="utf-8" />
    <link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <If condition={title !== undefined}>
      <title>{title}</title>
    </If>
    <slot name="head" />
  </head>
  <body>
    <div id='pre-footer' >
      <header id="main">
        <a href='/' >
          <img src='/images/name-pink.gif' class='header-image' alt='emma' />
          <img src='/images/username.gif' class='username' />
        </a>
      </header>
      <main>
        <slot />
      </main>
    </div>
    <SiteFooter {showEmojiLink} />
  </body>
</html>
